<!-- Root coordinator for parallax header effect like main wallet screen -->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tx_page_bg"
    >

    <!-- Header card - always expanded, contains direction, amount and QR code -->
    <!-- This card mimics main wallet balance card with levitate tag for parallax effect -->
    <androidx.cardview.widget.CardView
        android:id="@+id/card_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:tag="levitate"
        app:cardCornerRadius="2dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@color/bg_level1">
        >
        
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            >

            <ImageView
                android:id="@+id/iv_tx_qr"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:scaleType="fitCenter"
                android:padding="4dp"
                android:background="@drawable/bg_qr_white_rounded"
                android:clipToOutline="true"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="@string/tx_details_qr_desc"
                />

            <TextView
                android:id="@+id/tv_direction"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/iv_tx_qr"
                android:layout_marginEnd="12dp"
                android:textStyle="bold"
                android:textSize="22sp"
                android:textColor="@color/tx_text_primary"
                android:fontFamily="sans-serif-medium"
                />

            <TextView
                android:id="@+id/tv_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_direction"
                android:layout_alignStart="@id/tv_direction"
                android:layout_toStartOf="@id/iv_tx_qr"
                android:layout_marginTop="4dp"
                android:textSize="22sp"
                android:textStyle="bold"
                />

        </RelativeLayout>

    </androidx.cardview.widget.CardView>

    <!-- Scrollable content with shared system scrollbar - auto theme -->
    <!-- NestedScrollView holds all accordion cards below header -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:clipChildren="false"
        android:overScrollMode="never"
        android:scrollbars="vertical"
        android:fadeScrollbars="true"
        android:scrollbarStyle="outsideOverlay"
        >

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            >

            <!-- CARD 1: Sender / Receiver - collapsed by default -->
            <!-- Header shows title only, content contains actual from/to (filtered real addresses, not all inputs/outputs) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_sender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="2dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/tx_card_bg"
                android:layout_marginBottom="8dp"
                >

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    >

                    <!-- Clickable header - expands/collapses content_sender -->
                    <!-- Uses system selectableItemBackground for touch feedback (system flash, not app) -->
                    <TextView
                        android:id="@+id/header_sender"
                        android:text="@string/tx_details_sender_receiver"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@color/tx_text_primary"
                        android:padding="16dp"
                        android:drawableEnd="@android:drawable/arrow_down_float"
                        android:gravity="center_vertical"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        />

                    <!-- Collapsible content - GONE by default, shown on header click -->
                    <LinearLayout
                        android:id="@+id/content_sender"
                        android:orientation="vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        >

                        <TextView
                            android:text="@string/tx_details_from"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="@color/tx_text_secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            />

                        <TextView
                            android:id="@+id/tv_actual_from"
                            android:textColor="@color/tx_text_primary"
                            android:textIsSelectable="true"
                            android:fontFamily="monospace"
                            android:textSize="13sp"
                            android:layout_marginTop="4dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_marginTop="12dp"
                            android:layout_marginBottom="12dp"
                            android:background="#33000000"
                            />

                        <TextView
                            android:text="@string/tx_details_to"
                            android:textStyle="bold"
                            android:textSize="14sp"
                            android:textColor="@color/tx_text_secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            />

                        <TextView
                            android:id="@+id/tv_actual_to"
                            android:textColor="@color/tx_text_primary"
                            android:textIsSelectable="true"
                            android:fontFamily="monospace"
                            android:textSize="13sp"
                            android:layout_marginTop="4dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- CARD 2: Transaction details - collapsed by default -->
            <!-- Contains status, fee, size, confirmations, time, age -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_tx_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="2dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/tx_card_bg"
                android:layout_marginBottom="8dp"
                >

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    >

                    <TextView
                        android:id="@+id/header_tx_details"
                        android:text="@string/tx_details_transaction_details"
                        android:textStyle="bold"
                        android:textColor="@color/tx_text_primary"
                        android:textSize="16sp"
                        android:padding="16dp"
                        android:drawableEnd="@android:drawable/arrow_down_float"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        />

                    <LinearLayout
                        android:id="@+id/content_tx_details"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:paddingTop="0dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        >

                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            >

                            <TextView
                                android:text="@string/tx_details_status"
                                android:textSize="14sp"
                                android:textColor="@color/tx_text_secondary"
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                />

                            <TextView
                                android:id="@+id/tv_status"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                />

                        </LinearLayout>

                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            >

                            <TextView
                                android:text="@string/tx_details_fee"
                                android:textSize="14sp"
                                android:textColor="@color/tx_text_secondary"
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                />

                            <TextView
                                android:id="@+id/tv_fee"
                                android:textSize="14sp"
                                android:textColor="@color/tx_text_secondary"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                />

                        </LinearLayout>

                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            >

                            <TextView
                                android:text="@string/tx_details_size_weight"
                                android:textSize="14sp"
                                android:textColor="@color/tx_text_secondary"
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                />

                            <TextView
                                android:id="@+id/tv_meta"
                                android:textSize="14sp"
                                android:textColor="@color/tx_text_secondary"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                />

                        </LinearLayout>

                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            >

                            <TextView
                                android:text="@string/tx_details_confirmations"
                                android:textSize="14sp"
                                android:textColor="@color/tx_text_secondary"
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                />

                            <TextView
                                android:id="@+id/tv_height"
                                android:textSize="14sp"
                                android:textColor="@color/tx_text_secondary"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                />

                        </LinearLayout>

                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            >

                            <TextView
                                android:text="@string/tx_details_time"
                                android:textSize="14sp"
                                android:textColor="@color/tx_text_secondary"
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                />

                            <TextView
                                android:id="@+id/tv_time"
                                android:textSize="14sp"
                                android:textColor="@color/tx_text_secondary"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                />

                        </LinearLayout>

                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            >

                            <TextView
                                android:text="@string/tx_details_age"
                                android:textSize="14sp"
                                android:textColor="@color/tx_text_secondary"
                                android:layout_width="120dp"
                                android:layout_height="wrap_content"
                                />

                            <TextView
                                android:id="@+id/tv_age"
                                android:textSize="14sp"
                                android:textColor="@color/tx_text_secondary"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                />

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- CARD 3: Send / Receive details - collapsed by default -->
            <!-- Fixed header title using string resource, not inner content title -->
            <!-- Inner content has two sub-sections: Sent details and Received details -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_io"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="2dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/tx_card_bg"
                android:layout_marginBottom="8dp"
                >

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    >

                    <!-- Common parent title for both sent and received sections -->
                    <!-- Uses @string/tx_details_send_receive_details for localization -->
                    <TextView
                        android:id="@+id/header_io"
                        android:text="@string/tx_details_send_receive_details"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@color/tx_text_primary"
                        android:padding="16dp"
                        android:drawableEnd="@android:drawable/arrow_down_float"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        />

                    <LinearLayout
                        android:id="@+id/content_io"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:paddingTop="0dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        >

                        <!-- Sub-title for sent inputs - kept inside content, not used as card header -->
                        <TextView
                            android:text="@string/tx_details_sent_details"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="@color/tx_text_primary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            />

                        <TextView
                            android:id="@+id/tv_from"
                            android:textColor="@color/tx_text_secondary"
                            android:textIsSelectable="true"
                            android:fontFamily="monospace"
                            android:textSize="13sp"
                            android:lineSpacingExtra="2dp"
                            android:breakStrategy="simple"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="12dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="#33000000"
                            />

                        <!-- Sub-title for received outputs - kept inside content -->
                        <TextView
                            android:text="@string/tx_details_received_details"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:textColor="@color/tx_text_primary"
                            android:layout_marginTop="12dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            />

                        <TextView
                            android:id="@+id/tv_to"
                            android:textColor="@color/tx_text_secondary"
                            android:textIsSelectable="true"
                            android:fontFamily="monospace"
                            android:textSize="13sp"
                            android:lineSpacingExtra="2dp"
                            android:breakStrategy="simple"
                            android:layout_marginTop="4dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- CARD 4: Transaction ID - collapsed by default -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_txid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="2dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="@color/tx_card_bg"
                >

                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    >

                    <TextView
                        android:id="@+id/header_txid"
                        android:text="@string/tx_details_transaction_id"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@color/tx_text_primary"
                        android:padding="16dp"
                        android:drawableEnd="@android:drawable/arrow_down_float"
                        android:background="?android:attr/selectableItemBackground"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        />

                    <LinearLayout
                        android:id="@+id/content_txid"
                        android:orientation="vertical"
                        android:padding="16dp"
                        android:paddingTop="0dp"
                        android:visibility="gone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        >

                        <TextView
                            android:id="@+id/tv_txid"
                            android:textColor="@color/tx_text_secondary"
                            android:textIsSelectable="true"
                            android:fontFamily="monospace"
                            android:textSize="13sp"
                            android:layout_marginTop="4dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            />

                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
